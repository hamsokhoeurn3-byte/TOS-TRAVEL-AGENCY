APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql

# Supabase PostgreSQL — copy host, port, database, and user exactly as
# shown in your Supabase dashboard (Project Settings > Database) into the
# server-side environment of the Laravel host. Never commit real values.
#
# Connection method per Supabase's guidance (host and port come from the
# dashboard — do not guess them):
#   - Persistent Laravel server on an IPv4 network: Session pooler.
#   - Persistent server with IPv6 support, or running migrations
#     (php artisan migrate) when supported: direct connection.
#   - Serverless functions: transaction pooler.
# DB_HOST=
# DB_PORT=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# TLS is required by Supabase. 'require' encrypts without certificate
# verification; 'verify-full' additionally verifies the certificate using
# the Supabase CA certificate (bundled or via the host's CA store).
# Ignored when DB_CONNECTION is not pgsql.
DB_SSLMODE=require

# Set true ONLY when connecting through the transaction-mode pooler
# (serverless), which does not support server-side prepared statements.
# Ignored when DB_CONNECTION is not pgsql.
DB_EMULATE_PREPARES=false

# --- Local development with MySQL ----------------------------------------
# In your local (never committed) .env, set DB_CONNECTION=mysql instead
# and use these values; the pgsql-specific keys above are then ignored.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
